{
  "_tts_options": "piper, borg, espeak, piper_fast",
  "tts_backend": "espeak",
  "_backend_options": "google, keyboard, vosk, whispercpp_vad",
  "stt_backend": "whispercpp_vad",
  "_ai_options": "openai, echo, ollama",
  "ai_backend": "ollama",
  "ui_backend": "simple",
  "openai_model": "gpt-3.5-turbo",
  "ollama_base_url": "http://localhost:11434/v1",
  "ollama_model": "qwen2.5:1.5b",
