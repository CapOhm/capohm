  "vosk_sample_rate": 48000,
  "vosk_chunk_size": 4096,
  "ignore_stt_while_speaking": true,
  "speech_cooldown_seconds": 0.25,
  "piper_fast_mode": "cli",
  "piper_model_config": "voices/piper/en_US-joe-medium.onnx.json",
  "piper_sample_rate": 22050,
  "barge_in_commands": [
    "stop",
    "cancel",
    "enough",
    "genoeg",
    "hou op",
    "stil"
