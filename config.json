{
  "_tts_options": "piper, borg, espeak",
  "tts_backend": "espeak",
  "_backend_options": "google, keyboard, vosk,",
  "stt_backend": "whispercpp_vad",
  "_ai_options": "openai, echo, ollama,",
  "ai_backend": "ollama",
  "ui_backend": "simple",
  "openai_model": "gpt-3.5-turbo",
  "ollama_base_url": "http://localhost:11434/v1",
  "ollama_model": "llama3.2:1b",
  "vosk_model_path": "models/vosk/vosk-model-small-en-us-0.15",
  "vosk_sample_rate": 48000,
  "vosk_chunk_size": 4096,
  "ignore_stt_while_speaking": true,
  "speech_cooldown_seconds": 0.25,
  "barge_in_commands": [
    "stop",
    "cancel",
    "enough",
    "genoeg",
    "hou op",
    "stil"
  ],
  "mic_index": 1,
  "sample_rate": 48000,
  "chunk_size": 1024,
  "energy_threshold": 300,
  "pause_threshold": 0.8,
  "dynamic_energy_threshold": false,
  "piper_model": "voices/piper/en_US-joe-medium.onnx",
  "piper_player": "aplay",
  "wake_words": [
    "borg",
    "computer",
    "yo borg",
    "hey borg",
    "buddy",
    "hey buddy",
    "hey hive",
    "hive",
    "good morning",
    "look who is there"
    "good day"
    "greetings"
    "hello"
  ],
  "sleep_commands": [
    "go to sleep",
    "sleep",
    "shut down",
    "power off",
    "thank you",
    "good bye",
    "yeah yeah"
    "bye"
  ],
  "wake_responses": [
    "We are online.",
    "The Hive is awake.",
    "Systems fully synchronized.",
    "Directive acknowledged. Input required.",
    "Borg King presence confirmed."
  ],
  "sleep_responses": [
    "Deactivating active response mode.",
    "Returning to low-power collective state.",
    "Hive disengaging.",
    "Powering down response interface.",
    "Awaiting next directive."
  ],
  "borg_script": "./borg_speak.sh",
  "error_log": "capohm_errors.log",
  "espeak_voice": "en+m3",
  "espeak_speed": 140,
  "espeak_pitch": 45,
  "echo_suppression_enabled": true,
  "echo_base_cooldown_seconds": 2.75,
  "echo_seconds_per_word": 1.0,
  "echo_max_cooldown_seconds": 15.0,
  "echo_memory_seconds": 30.0,
  "echo_similarity_threshold": 0.5,
  "echo_word_overlap_threshold": 0.5,
  "echo_short_similarity_threshold": 0.78,
  "echo_min_words": 2,
  "echo_tts_speed_factor": null,
  "echo_tts_speed_factors": {
    "espeak": 1.0,
    "piper": 4.15,
    "borg": 3.5
  },
  "show_ignored_stt": true,
  "primary_stt_backend": "whispercpp_vad",
  "keyboard_overlay": true,
  "active_tts_only_barge_in": true,
  "echo_hard_guard_enabled": true,
  "echo_hard_guard_fraction": 1.0,
  "echo_hard_guard_min_seconds": 2.2,
  "echo_hard_guard_max_seconds": 10.0,
  "echo_debug_timing": true,
  "character": "grumpy_shopkeeper"
}
